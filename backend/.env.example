# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the values.
# On Render, set the same values in the service's Environment tab
# (or let render.yaml generate DEVICE_API_KEY for you).
# ---------------------------------------------------------------------------

# Public port. Render injects PORT automatically; 3000 is used locally.
PORT=3000

# Shared secret that the ESP32 sends in the x-api-key header.
# Use a long random value, for example: openssl rand -hex 32
# (Windows PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) }))
# The SAME value must be flashed into firmware/water_monitor.ino.
DEVICE_API_KEY=change-me-to-a-long-random-string

# Optional: reject readings from any device with a different id.
# Leave empty to accept any well-formed deviceId.
DEVICE_ID=esp32-water-01

# A device is marked offline when no reading arrives within this window.
# Readings arrive every 2 s, so 15000 ms tolerates ~6 missed uploads.
OFFLINE_AFTER_MS=15000

# Comma-separated list of allowed browser origins, or * to allow all.
# Because the dashboard is served by this same server, * is fine, but you can
# restrict it to your Render URL, e.g. https://smart-water-monitoring.onrender.com
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# LOW / FULL alerts - optional, free Telegram Bot API
# ---------------------------------------------------------------------------
# 1. In Telegram open @BotFather -> /newbot -> copy the bot token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat "id".
# 3. Fill both values below (or add them in Render -> Environment) and restart.
# Leave both empty to keep alerts disabled; everything else still works.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to false to mute alerts without removing the credentials.
ALERTS_ENABLED=true

# Alert when the level drops below this percentage.
ALERT_LOW_PERCENT=25

# Alert when the level reaches this percentage.
ALERT_FULL_PERCENT=90

# Hysteresis, in percentage points, so a level sitting on a threshold cannot
# flap between alert and no-alert every 2 seconds.
ALERT_HYSTERESIS_PERCENT=2

# Minimum time between two alert messages (default 10 minutes).
ALERT_COOLDOWN_MS=600000
